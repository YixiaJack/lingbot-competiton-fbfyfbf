+    def _prune_resume_only(keep: str) -> None:  # rank 0, after `keep` was saved
+        # deletes only checkpoints older than `keep` (user request 10/24), except the newest one with a complete
+        # hf_ckpt (for evaluation), the newest one saved by each world size (fallback for a member with another
+        # GPU count) and any checkpoint holding a file named `keep`
+        import shutil, threading
+        try:
+            root, keep_step = os.path.dirname(keep), int(os.path.basename(keep).rsplit("_", 1)[1])
+            steps = {int(m.group(1)): os.path.join(root, m.group(0)) for m in
+                     (re.fullmatch(r"global_step_(\d+)", n) for n in os.listdir(root)) if m}
+            hf_ok = lambda p: os.path.exists(os.path.join(p, "hf_ckpt", "model.safetensors.index.json"))
+            newest_hf = max((st for st, p in steps.items() if st <= keep_step and hf_ok(p)), default=None)
