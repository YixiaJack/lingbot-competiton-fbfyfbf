+            newest_ws = {n_ranks(steps[st]): st for st in sorted(steps) if st <= keep_step}  # world size -> step
+            newest_ws.pop(0, None)
+            doomed = [os.path.join(root, n) for n in os.listdir(root) if n.endswith(".deleting")]
+            for st, path in steps.items():
+                if st >= keep_step or st in (newest_hf, *newest_ws.values()) or os.path.exists(os.path.join(path, "keep")):
+                    continue
+                os.rename(path, path + ".deleting")  # the resume scan only matches global_step_<n>
+                logger.info_rank0(f"deleting checkpoint {path} (keeping {keep_step}, hf {newest_hf}, "
+                                  f"per world size {newest_ws})")
+                doomed.append(path + ".deleting")
+            for path in doomed:
+                threading.Thread(target=shutil.rmtree, args=(path,), kwargs={"ignore_errors": True},
+                                 daemon=True).start()
+        except Exception as e:  # never stop training over a cleanup
+            logger.info_rank0(f"checkpoint cleanup failed: {e!r}")
+
+    # LingBotRoboTwin: preemptible partitions may end a job 30 min after it starts (PreemptExemptTime) with no
+    # grace time, so a member slower than save_steps per ~25 min (2xA100: 200 steps x 15 s) restarted from the
+    # same checkpoint every time. LINGBOT_TIME_SAVE_MIN=m (default 24, 0 = off) also saves at m, 2m, ... minutes
+    # after the process started (resume state only, no hf_ckpt), whatever step saves happened in between; skipped
+    # when a save finished under LINGBOT_TIME_SAVE_SKIP_MIN (default 3) minutes earlier. Rank 0's clock decides
+    # (broadcast every step) so that all ranks enter the collective save together.
+    _time_save_min = float(os.environ.get("LINGBOT_TIME_SAVE_MIN", "24"))
+    _time_save_skip_min = float(os.environ.get("LINGBOT_TIME_SAVE_SKIP_MIN", "3"))
+    _last_save_time = [_PROCESS_START]
+    _next_time_save = [_PROCESS_START + 60 * _time_save_min]
+
+    def _time_save_due() -> bool:
+        if _time_save_min <= 0:
+            return False
+        now = time.time()
+        due = now >= _next_time_save[0] and now - _last_save_time[0] >= 60 * _time_save_skip_min
+        while _next_time_save[0] <= now:  # next slot on the grid counted from the process start
+            _next_time_save[0] += 60 * _time_save_min
+        due = torch.tensor([int(due)], dtype=torch.int32, device="cuda")
+        dist.broadcast(due, src=0)
+        return bool(due.item())
