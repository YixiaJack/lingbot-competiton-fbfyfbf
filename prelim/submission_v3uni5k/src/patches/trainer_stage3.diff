+def _lb_reseed(key, worker_id=None):
+    # LingBotRoboTwin: seeds torch (CPU + CUDA), random and numpy from `key` (+ a dataloader worker id); see main()
+    import hashlib
+    import random
+    s = int.from_bytes(hashlib.sha256(repr((*key, worker_id)).encode()).digest()[:8], "little") >> 1
+    torch.manual_seed(s)
+    random.seed(s)
+    np.random.seed(s % 2**32)
+
